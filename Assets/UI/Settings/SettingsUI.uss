VisualElement {
}

.unity-button {
    background-image: url("project://database/Assets/UI/Settings/Textures/buttonBACK.png?fileID=2800000&guid=a13323efc39e77442816014e3af43700&type=3#buttonBACK");
    transition-property: all;
    transition-duration: 0s;
    transition-timing-function: ease;
    transition-delay: 0s;
}

.unity-button:hover {
    background-image: url("project://database/Assets/UI/Settings/Textures/buttonBACK2.png?fileID=2800000&guid=aac315c69cd939e41b6d7ab080f096d0&type=3#buttonBACK2");
    scale: 1.2;
    transition-property: all, scale;
    transition-duration: 0s, 0.6s;
    transition-timing-function: ease, ease;
    transition-delay: 0s, 0s;
}

.unity-slider {
    background-image: none;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-base-slider > .unity-base-slider__label {
    min-width: 40%;
    width: 40%;
    white-space: normal;
}

.unity-base-slider > .unity-base-slider__input {
    scale: 1 1.5;
    background-image: none;
    background-size: 100% 16px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    height: 33px;
    position: relative;
    top: 40px;
}

.unity-slider #unity-dragger {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Settings/Textures/Union.svg?fileID=7388822144124034973&guid=46c31d92accac7e46aff48bd80018f38&type=3#Union");
    -unity-background-image-tint-color: rgb(241, 241, 241);
    width: 69px;
    height: 40px;
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    top: 7px;
}

.unity-slider #unity-drag-container {
    background-color: rgb(247, 238, 196);
    background-image: url("project://database/Assets/UI/Settings/Textures/Variant4.png?fileID=21300000&guid=ba90255d995d6764786fcae4a0f99494&type=3#Variant4");
    border-top-left-radius: 21px;
    border-bottom-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    visibility: visible;
}

.unity-slider #unity-tracker {
    color: rgba(27, 27, 27, 0);
    flex-grow: 1;
    top: 9px;
    left: 0;
    right: 0;
    visibility: visible;
    overflow: hidden;
    height: 21px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: 560px;
    align-items: center;
    align-self: center;
    align-content: center;
    transform-origin: right;
    translate: 17px 0;
}

.unity-slider #unity-fill {
    background-color: rgb(229, 174, 174);
    border-top-left-radius: 7px;
    border-bottom-left-radius: 7px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    margin-right: 5px;
    margin-left: 5px;
}
