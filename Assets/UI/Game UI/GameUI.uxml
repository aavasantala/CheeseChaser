<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:engine="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Game%20UI/GameUI.uss?fileID=7433441132597879392&amp;guid=014fd85f5ebc4a249b81fd87c92b3592&amp;type=3#GameUI"/>
    <ui:VisualElement name="root" picking-mode="Ignore" style="flex-grow: 1; justify-content: space-between; align-items: center; width: 100%; height: 100%; position: relative; overflow: hidden;">
        <ui:VisualElement name="crosshair" picking-mode="Ignore" style="position: absolute; width: 64px; height: 64px; left: auto; top: 50%; translate: -50% -50%; background-image: url(&quot;project://database/Assets/UI/Game%20UI/crosshair.png?fileID=21300000&amp;guid=5bc5a2954bdfedf47bc8b0385471be1d&amp;type=3#crosshair&quot;); background-size: contain; background-repeat: no-repeat; background-position: center; opacity: 0.9; align-self: center;"/>
        <ui:VisualElement style="flex-grow: 1; align-self: flex-end;">
            <ui:VisualElement name="smallMouse" style="flex-grow: 1; width: 368px; align-self: flex-end; align-items: flex-end; position: absolute; height: 235px; left: -440px; top: 841px; align-content: auto; justify-content: flex-start; opacity: 1;">
                <ui:Image name="Image" source="project://database/Assets/UI/Game%20UI/timer_small_mode_timer.png?fileID=2800000&amp;guid=0bfd21a424d6a9f4da0d9985b1e88ff9&amp;type=3#timer_small_mode_timer" style="height: 221px; width: 241px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="bigMouse" style="flex-grow: 1; width: 368px; align-self: flex-end; align-items: flex-end; position: absolute; height: 235px; left: -440px; top: 841px; align-content: auto; justify-content: flex-start; opacity: 1; transition-property: all, opacity; transition-duration: 0s, 1.5s; transition-timing-function: ease, ease; transition-delay: 0s, 0s;">
                <ClockWipeRing name="clock-ring" ring-radius="0.39" ring-thickness="0.1" style="position: absolute; width: 100%; height: 100%; padding-left: 126px; margin-top: -7px;"/>
                <ui:Image name="Image" source="project://database/Assets/UI/Game%20UI/timer_outline.png?fileID=2800000&amp;guid=e1ff5b5967c872344a81d12afff26c88&amp;type=3#timer_outline" style="height: 221px; width: 241px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
