.root {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    position: relative;
}

.bg-cheese {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/MainMenuStuff/Textures/cheese_pattern.png?fileID=2800000&guid=f34bfd2d6788f0349895d4299762a864&type=3#cheese_pattern");
    background-size: cover;
    opacity: 100%;
    z-index: 0;
}

.title {
    font-size: 72px;
    color: rgb(255, 250, 227);
    unity-text-align: middle;
    margin-bottom: 60px;
    unity-font-style: bold;
    text-shadow: 3px 3px 0 rgb(217, 164, 65);
    z-index: 1;
}

.button {
    width: 250px;
    height: 60px;
    margin-bottom: 20px;
    font-size: 22px;
    color: rgb(255, 255, 255);
    background-color: rgb(165, 103, 42);
    border-radius: 12px;
    unity-font-style: bold;
    transition: all 0.15s ease-in-out;
    z-index: 1;
}

.button:hover {
    scale: 1.1;
    background-color: rgb(255, 204, 102);
    color: rgb(51, 51, 51);
}



.title {
    animation: wobble 2s infinite ease-in-out;
}

.mouse-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/MainMenuStuff/Textures/mouse_silhouette.png?fileID=21300000&guid=f6c9ce3f96bc8df48a31d898578818ca&type=3#mouse_silhouette");
    background-size: contain;
    background-repeat: repeat;
    opacity: 0.05;
    z-index: 0;
    pointer-events: none;
}
