    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; position: absolute; align-items: auto; justify-content: center; align-self: center; align-content: center; width: 1920px; height: 1080px; top: 2px; background-image: url(&quot;project://database/Assets/UI/Tutorial/UI_other_screens_darker.png?fileID=2800000&amp;guid=c64f60e9b7357714681004ad3c440cb8&amp;type=3#UI_other_screens_darker&quot;); left: -3px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0);">
