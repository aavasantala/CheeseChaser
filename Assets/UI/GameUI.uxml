<engine:UXML xmlns:ui="UnityEngine.UIElements" xmlns:engine="UnityEngine.UIElements">
    <ui:VisualElement name="root"
                      style="flex-grow: 1;
                             justify-content: space-between;
                             align-items: center;
                             width: 100%;
                             height: 100%;
                             position: relative;
                             overflow: hidden;">

        
        <ui:Label name="mushroomCounter"
                  text="🍄 x 0"
                  style="position: absolute;
                         top: 10px;
                         left: 10px;
                         font-size: 28px;
                         color: white;
                         -unity-font-style: bold;
                         unity-text-outline-color: black;
                         unity-text-outline-width: 1;" />

        
        <ui:VisualElement name="crosshair"
                          style="position: absolute;
                                 width: 64px;
                                 height: 64px;
                                 left: 50%;
                                 top: 50%;
                                 translate: -50% -50%;
                                 background-image: url('project://database/Assets/UI/crosshair.png');
                                 background-size: contain;
                                 background-repeat: no-repeat;
                                 background-position: center;
                                 opacity: 0.9;" />
    </ui:VisualElement>
</engine:UXML>
