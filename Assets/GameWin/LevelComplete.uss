.root {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.23);
}

.title {
    font-size: 40px;
    color: white;
    unity-text-align: middle;
    margin-bottom: 30px;
}

.button {
    width: 220px;
    height: 48px;
    margin-bottom: 10px;
    font-size: 18px;
    color: white;
    background-color: rgb(30, 30, 30);
    border-radius: 8px;
    unity-font-style: bold;
}
