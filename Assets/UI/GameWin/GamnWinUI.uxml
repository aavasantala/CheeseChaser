<ui:UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="UnityEngine.UIElements/UXMLSchema.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameWin/LevelComplete.uss?fileID=7433441132597879392&amp;guid=71ab91c1cf48c374498df2ac82a5fb29&amp;type=3#LevelComplete"/>
    <ui:VisualElement name="root" class="root" style="background-color: rgba(0, 0, 0, 0);">
        <ui:VisualElement name="screen" style="flex-grow: 1; position: absolute; width: 1920px; left: auto; height: 1080px; top: 0; background-image: url(&quot;project://database/Assets/UI/Settings/Textures/UI_other_screens_darker.png?fileID=2800000&amp;guid=4d6dbb25683e4ea478d856e97a283185&amp;type=3#UI_other_screens_darker&quot;); transition-property: scale; transition-duration: 1s; transition-timing-function: ease; transition-delay: 0s;">
            <ui:Label name="levelCompleteText" text="Level Completed&#10;" class="title" style="scale: 2 2; top: 62px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Ubuntu-Bold.ttf?fileID=12800000&amp;guid=0af5777e3d8a7814abe70b283c4e5223&amp;type=3#Ubuntu-Bold&quot;); color: rgb(255, 239, 195); font-size: 53px;"/>
            <ui:Button name="btnRestart" text="Restart Level" double-click-selects-word="false" triple-click-selects-line="false" class="button" style="top: 367px; align-self: center; height: 37px; background-image: none; left: -442px; transition-property: all, scale; transition-duration: 0s, 0.4s; transition-timing-function: ease, ease; transition-delay: 0s, 0s; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(30, 30, 30, 0); color: rgb(255, 239, 195); font-size: 31px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Ubuntu-Bold.ttf?fileID=12800000&amp;guid=0af5777e3d8a7814abe70b283c4e5223&amp;type=3#Ubuntu-Bold&quot;); width: 226px;"/>
            <ui:Button name="btnMainMenu" text="Main Menu" double-click-selects-word="false" triple-click-selects-line="false" class="button" style="top: 144px; height: 25px; left: 1052px; background-image: none; transition-property: all, scale; transition-duration: 0s, 0.4s; transition-timing-function: ease, ease; transition-delay: 0s, 0s; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(30, 30, 30, 0); font-size: 31px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Ubuntu-Bold.ttf?fileID=12800000&amp;guid=0af5777e3d8a7814abe70b283c4e5223&amp;type=3#Ubuntu-Bold&quot;); color: rgb(255, 239, 195); width: 180px;"/>
            <ui:Button name="btnNextLevel" text="Next Level" double-click-selects-word="false" triple-click-selects-line="false" icon-image="" class="button" style="top: 100px; align-self: center; background-image: none; height: 40px; left: -442px; transition-duration: 0.4s; transition-property: scale; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Ubuntu-Bold.ttf?fileID=12800000&amp;guid=0af5777e3d8a7814abe70b283c4e5223&amp;type=3#Ubuntu-Bold&quot;); font-size: 31px; color: rgb(255, 239, 195); background-color: rgba(30, 30, 30, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 180px;"/>
            <ui:Button name="btnQuitGame" text="Exit To Desktop" double-click-selects-word="false" triple-click-selects-line="false" class="button" style="top: 230px; height: 36px; left: 1052px; transition-property: all, scale; transition-duration: 0s, 0.4s; transition-timing-function: ease, ease; transition-delay: 0s, 0s; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(255, 255, 255, 0); color: rgb(255, 239, 195); font-size: 31px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Ubuntu-Bold.ttf?fileID=12800000&amp;guid=0af5777e3d8a7814abe70b283c4e5223&amp;type=3#Ubuntu-Bold&quot;); width: 258px;"/>
            <ui:Label text="(this will restart the level)" style="position: absolute; font-size: 31px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Ubuntu-Italic.ttf?fileID=12800000&amp;guid=b1497a58981dcd648bae9dfe051f1f8b&amp;type=3#Ubuntu-Italic&quot;); -unity-text-outline-color: rgb(255, 239, 195); color: rgb(255, 239, 195); top: 230px; left: 344px;"/>
